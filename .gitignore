# 构建产物
build/

# 编辑器与 IDE 的本地文件
# 注意：.gitignore 不支持「规则 + 行尾注释」，注释必须单独占一行，
#       否则整行会被当成一条匹配不到的规则，形同失效。
.vs/
*.sln.docstates
.vscode/
*.user
*.suo
*.ncb
*.sdf
*.opendb
*.VC.db

# 编译中间文件（若在源码目录误编译）
*.obj
*.o
*.exe
*.pdb
*.ilk
*.idb
*.exp
*.lib

# 操作系统生成的文件
Thumbs.db
desktop.ini
.DS_Store

# Office 打开文档时产生的临时锁文件（~$ 开头），打开 Word 时会出现
~$*

# 顺手截图留下的临时图片（正式的演示图放在 docs/images/ 下，要纳入版本管理）
/*.png
/*.jpg

# 编译中间产物误落在源码目录时（build.bat 与 CMake 都会把它们留在 build\ 下）
src/*.obj
tools/*.obj

# 回归测试的运行产物（in.txt 与 expected.txt 要纳入版本管理，actual.txt 不）
_test/actual.txt
# Qt 图形界面（CMake + Ninja 的构建目录，以及 --shots 模式生成的截图）
# 说明：build\ 已在上面整体忽略，这里只是把 Qt 特有的产物说明白
build/qt/
build/qt_shots/

# 共享数据区（两进程共享数据用的内存映射文件，运行时生成，不是数据源）
data/state.bin
